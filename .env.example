# Bungie API Configuration
# Register your app at https://www.bungie.net/en/Application
BUNGIE_API_KEY=your_api_key_here
BUNGIE_CLIENT_ID=your_client_id_here
BUNGIE_CLIENT_SECRET=your_client_secret_here

# App URL (used for OAuth callback)
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Session encryption key (generate a random 32+ char string)
SESSION_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# DIM Sync API key (optional — enables the "Sync to DIM" button)
# See the "DIM Sync integration" section of the README for how to register one.
DIM_API_KEY=
